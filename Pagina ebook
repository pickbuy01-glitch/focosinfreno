        function toggleFaq(id) {
            const answer = document.getElementById(`faq-${id}`);
            answer.classList.toggle('hidden');
        }

        // Función para mostrar la CTA Header al hacer scroll
        window.addEventListener('scroll', function() {
            const header = document.getElementById('cta-header');
            // Muestra después de los primeros 400px
            if (window.scrollY > 400) { 
                header.classList.remove('-translate-y-full');
            } else {
                header.classList.add('-translate-y-full');
            }
        });

        // ----------------------------------------------------
        // INTEGRACIÓN GEMINI API (Detector de Procrastinación)
        // ----------------------------------------------------
        const apiKey = ""; 

        async function getProcrastinationDiagnosis(problemText) {
            // URL de la API para gemini-2.5-flash-preview-05-20
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;
            const diagnosisResultDiv = document.getElementById('diagnosis-result');
            const diagnosisButton = document.getElementById('diagnosis-button');

            // Mostrar estado de carga
            diagnosisResultDiv.innerHTML = '<p class="text-gray-500 flex items-center justify-center"><svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-focus" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Analizando tu problema con el Sistema F.O.C.O...</p>';
            diagnosisButton.disabled = true;

            // Instrucción del sistema para forzar el rol y la respuesta
            const systemPrompt = "Actúa como un analista experto en productividad del 'Sistema F.O.C.O.' (Filtra, Organiza, Concéntrate, Otorga). Analiza el problema de procrastinación que el usuario describe. Responde con un diagnóstico conciso de UNA SOLA FRASE utilizando la terminología del libro (ej: Parálisis por Análisis, Falta de Deep Work, Perfeccionismo, etc.) y añade UNA SOLA FRASE de recomendación que apunte a la solución del ebook. Tu objetivo es conectar el dolor del usuario con la solución del sistema F.O.C.O. Mantén la respuesta a un máximo de 2 frases. NO incluyas ninguna introducción o saludo, ve directo al diagnóstico.";
            
            const userQuery = `Mi mayor problema de procrastinación es: ${problemText}`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                },
            };

            try {
                let response;
                let attempt = 0;
                const MAX_RETRIES = 3;
                
                while (attempt < MAX_RETRIES) {
                    response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        break; // Éxito
                    }

                    attempt++;
                    if (attempt < MAX_RETRIES) {
                        const delay = Math.pow(2, attempt) * 1000; // Backoff: 1s, 2s, 4s
                        await new Promise(resolve => setTimeout(resolve, delay));
                    } else {
                        // Si falla después del último intento, lanzamos un error
                        throw new Error(`La llamada a la API falló después de ${MAX_RETRIES} reintentos.`);
                    }
                }

                const result = await response.json();
                // Extraer el texto generado
                const diagnosis = result.candidates?.[0]?.content?.parts?.[0]?.text || "Error: No se pudo generar el diagnóstico. Intenta describir tu problema con más detalle.";
                
                // Mostrar el resultado formateado
                diagnosisResultDiv.innerHTML = `
                    <div class="bg-white p-4 rounded-lg shadow-inner border-l-4 border-red-500 text-left mt-2">
                        <p class="font-bold text-base mb-1 text-focus">✨ Diagnóstico F.O.C.O. Personalizado:</p>
                        <p class="text-gray-700 text-sm">${diagnosis}</p>
                    </div>
                `;

            } catch (error) {
                // Loguear el error en la consola del navegador para ayudar a la depuración
                console.error('Error de red o de API al obtener el diagnóstico:', error);
                
                // Mensaje al usuario sobre la posible causa en entornos restringidos
                diagnosisResultDiv.innerHTML = `<p class="text-red-600 font-medium">Ocurrió un error al conectar con el asistente (error de red/seguridad). Esto puede deberse a **restricciones de la plataforma de alojamiento** (como Google Sites) que bloquean las llamadas a APIs externas. Por favor, revisa la consola del navegador para más detalles.</p>`;
            } finally {
                diagnosisButton.disabled = false;
            }
        }

        // Función para manejar el clic del botón
        function handleDiagnosis() {
            const problemInput = document.getElementById('problem-input');
            const problemText = problemInput.value.trim();

            if (problemText.length < 10) {
                document.getElementById('diagnosis-result').innerHTML = '<p class="text-red-600">Por favor, describe tu problema en al menos 10 caracteres para un análisis preciso.</p>';
                return;
            }

            getProcrastinationDiagnosis(problemText);
        }
    </script>
</body>
</html>
